[Unit]
Description=Tension Index Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@APP_USER@
WorkingDirectory=@APP_DIR@
ExecStart=@UV@ run --frozen --no-dev tension-index bot
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target

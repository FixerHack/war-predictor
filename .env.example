# Copy to .env and fill in. Never commit .env.

# --- Telegram (aiogram) ---
TELEGRAM_BOT_TOKEN=
# Channel/chat for alerts, e.g. -1001234567890
TELEGRAM_CHAT_ID=
# Comma-separated Telegram user IDs allowed to run admin commands
TELEGRAM_ADMIN_IDS=

# --- Claude API (needed from stage S5: classification) ---
# Provider: openrouter (Claude Haiku 4.5 via https://openrouter.ai) or anthropic (direct).
# openrouter | anthropic | claude_code (the local `claude` CLI signed in with a Claude
# subscription: no API key, uses the subscription's usage limits)
CLASSIFIER_PROVIDER=openrouter
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Empty = provider default: openrouter -> anthropic/claude-haiku-4.5,
# anthropic -> claude-opus-5-5 (then CLASSIFIER_EFFORT=low applies)
CLASSIFIER_MODEL=
CLASSIFIER_EFFORT=
# Max Claude calls per run; the rest is classified by keyword rules
CLASSIFIER_MAX_CALLS=60
# claude_code only: path to the CLI if it is not on PATH
CLAUDE_CODE_BIN=claude

# --- Sources ---
# Skipped by the regular cycle (comma-separated). Empty = all sources.
# Australia (au) is off by default: its site does not answer automated requests.
DISABLED_SOURCES=au

# --- Storage ---
DATABASE_PATH=data/tension.sqlite3

# --- Collector ---
HTTP_TIMEOUT_SECONDS=30
HTTP_USER_AGENT=TensionIndexBot/0.1 (+https://github.com/FixerHack/war-predictor)

# --- Healthcheck ---
# A source is "stale" if its last successful fetch is older than this
HEALTH_MAX_COLLECT_AGE_HOURS=8
# Minimum free disk space for the data directory
HEALTH_MIN_FREE_DISK_MB=500
# Optional dead-man switch URL (e.g. https://hc-ping.com/<uuid>), pinged on healthy run
HEALTH_PING_URL=

LOG_LEVEL=INFO

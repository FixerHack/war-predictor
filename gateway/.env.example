# claude-gateway settings (copy to .env next to this file or into the systemd EnvironmentFile)

# Required: one or more tokens, comma-separated. Clients send `Authorization: Bearer <token>`
# (or `x-api-key: <token>`). Generate one: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
GATEWAY_TOKENS=
# Listen address. Keep 127.0.0.1 and put a reverse proxy with HTTPS in front for remote access.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8787
# Path to the Claude Code CLI if it is not on PATH
GATEWAY_CLAUDE_BIN=claude
# claude -p processes at once, and seconds per request
GATEWAY_CONCURRENCY=4
GATEWAY_TIMEOUT=120
# Default model alias, and an optional allow-list (empty = any): haiku,sonnet,opus
GATEWAY_DEFAULT_MODEL=haiku
GATEWAY_ALLOWED_MODELS=
# 1 = let the CLI use extended thinking (slower)
GATEWAY_THINKING=

# On a server without a browser: run `claude setup-token` on a machine where you are signed in
# and put the printed token here (the CLI reads it from the environment).
CLAUDE_CODE_OAUTH_TOKEN=

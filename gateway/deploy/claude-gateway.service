# Installed by scripts/install.sh (placeholders are filled in there).
[Unit]
Description=claude-gateway: HTTP API and MCP on top of Claude Code
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@APP_USER@
WorkingDirectory=@GW_DIR@
EnvironmentFile=@GW_DIR@/.env
Environment=PATH=@HOME@/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=@UV@ run --frozen --no-dev claude-gateway serve
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
